# API Configuration
NEXT_PUBLIC_API_URL=your_api_url

# 운영 앱(찾아줘!) 주소. 게시글 상세, 공지 상세, 비밀번호 변경 링크에 쓴다. 비우면 https://www.finditem.kr
NEXT_PUBLIC_SERVICE_URL=https://www.finditem.kr

# 서비스 통계(/admin/analytics)용 GA Data API 설정. 서버에서만 쓰므로 NEXT_PUBLIC_을 붙이지 않는다.
# GA 속성에 "뷰어" 권한을 준 Google Cloud 서비스 계정의 이메일과 비공개 키를 넣는다.
# 비공개 키는 줄바꿈을 \n으로 바꿔 한 줄로 넣는다.
GA_PROPERTY_ID=510805727
GA_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# DB 조회(/admin/db)용 Metabase 설정. 서버에서만 쓰므로 NEXT_PUBLIC_을 붙이지 않는다.
# 어드민은 DB에 직접 붙지 않고 Metabase API로만 조회한다. API 키는 Metabase 관리자 설정 > 인증 > API 키에서 만든다.
# METABASE_DATABASE_ID는 Metabase 관리자 설정 > 데이터베이스에서 DB를 열었을 때 주소 끝의 숫자다.
METABASE_URL=http://localhost:3100
METABASE_API_KEY=
METABASE_DATABASE_ID=
